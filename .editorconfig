# EditorConfig — 项目统一格式规则。
# 与 coding-standards 规范一致：Go 用 tab 缩进，其余用 2 空格，行宽 100。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.go]
indent_style = tab
indent_size = 8

[Makefile]
indent_style = tab

[*.md]
# Markdown 表格按格式必须保持单行，不做行宽限制。
trim_trailing_whitespace = false
max_line_length = off
